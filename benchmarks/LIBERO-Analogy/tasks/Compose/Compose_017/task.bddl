(define (problem LIBERO_Floor_Manipulation)
  (:domain robosuite)
  (:language Put the tomato sauce in the basket, and then put the yellow and white mug on the plate)
  (:regions
      (bin_region
          (:target floor)
          (:ranges (
              (-0.01 0.25 0.01 0.27)
            )
          )
      )
      (target_object_region
          (:target floor)
          (:ranges (
              (-0.145 -0.265 -0.095 -0.215)
            )
          )
      )
      (other_object_region_0
          (:target floor)
          (:ranges (
              (0.025 -0.125 0.07500000000000001 -0.07500000000000001)
            )
          )
      )
      (other_object_region_1
          (:target floor)
          (:ranges (
              (-0.175 0.034999999999999996 -0.125 0.08499999999999999)
            )
          )
      )
      (other_object_region_2
          (:target floor)
          (:ranges (
              (0.07500000000000001 -0.225 0.125 -0.17500000000000002)
            )
          )
      )
      (other_object_region_3
          (:target floor)
          (:ranges (
              (0.125 0.0049999999999999975 0.175 0.055)
            )
          )
      )
      (other_object_region_4
          (:target floor)
          (:ranges (
              (-0.225 -0.10500000000000001 -0.17500000000000002 -0.055)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
      (transferred_target_region
          (:target floor)
          (:ranges (
              (-0.145000 -0.265000 -0.095000 -0.215000)
            )
          )
      )
      (distractor_salad_region
          (:target floor)
          (:ranges (
              (-0.175000 0.035000 -0.125000 0.085000)
            )
          )
      )
      (distractor_milk_region
          (:target floor)
          (:ranges (
              (-0.225000 -0.105000 -0.175000 -0.055000)
            )
          )
      )
      (transferred_yellow_mug_region
          (:target floor)
          (:ranges (
              (0.025000 -0.125000 0.075000 -0.075000)
            )
          )
      )
      (transferred_plate_region
          (:target floor)
          (:ranges (
              (0.125000 0.005000 0.175000 0.055000)
            )
          )
      )
  )

  (:fixtures
    floor - floor
  )

  (:objects
    basket_1 - basket
    tomato_sauce_1 - tomato_sauce
    salad_dressing_1 - salad_dressing
    milk_1 - milk
    white_yellow_mug_1 - white_yellow_mug
    plate_1 - plate
  )

  (:obj_of_interest
    tomato_sauce_1
    basket_1
    white_yellow_mug_1
    plate_1
  )

  (:init
    (On basket_1 floor_bin_region)
    (On tomato_sauce_1 floor_transferred_target_region)
    (On salad_dressing_1 floor_distractor_salad_region)
    (On milk_1 floor_distractor_milk_region)
    (On white_yellow_mug_1 floor_transferred_yellow_mug_region)
    (On plate_1 floor_transferred_plate_region)
  )

  (:goal
    (And (In tomato_sauce_1 basket_1_contain_region) (On white_yellow_mug_1 plate_1))
  )

)
