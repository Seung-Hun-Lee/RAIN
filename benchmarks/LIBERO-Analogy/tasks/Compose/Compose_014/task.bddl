(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Put the moka pot on the stove, then close the bottom drawer of the cabinet)
  (:regions
      (flat_stove_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.21000000000000002 -0.21000000000000002 -0.19 -0.19)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (moka_pot_right_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.07500000000000001 0.225 -0.025 0.275)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (moka_pot_left_init_region
          (:target kitchen_table)
          (:ranges (
              (0.025 0.025 0.07500000000000001 0.07500000000000001)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cook_region
          (:target flat_stove_1)
      )
      (md_flat_stove_1_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.21000000000000002 -0.21000000000000002 -0.19 -0.19)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (md_white_cabinet_1_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.01 0.29 0.01 0.31)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (top_side
          (:target white_cabinet_1)
      )
      (top_region
          (:target white_cabinet_1)
      )
      (middle_region
          (:target white_cabinet_1)
      )
      (bottom_region
          (:target white_cabinet_1)
      )
      (md_moka_pot_2_init_region
          (:target kitchen_table)
          (:ranges (
              (0.025 0.025 0.07500000000000001 0.07500000000000001)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
  )

  (:fixtures
    kitchen_table - kitchen_table
    flat_stove_1 - flat_stove
    white_cabinet_1 - white_cabinet
  )

  (:objects
    moka_pot_2 - moka_pot
  )

  (:obj_of_interest
    moka_pot_2
    flat_stove_1_cook_region
    white_cabinet_1_bottom_region
  )

  (:init
    (On flat_stove_1 kitchen_table_md_flat_stove_1_init_region)
    (Turnon flat_stove_1)
    (On white_cabinet_1 kitchen_table_md_white_cabinet_1_init_region)
    (On moka_pot_2 kitchen_table_md_moka_pot_2_init_region)
  )

  (:goal
    (And (On moka_pot_2 flat_stove_1_cook_region) (Close white_cabinet_1_bottom_region))
  )

)
