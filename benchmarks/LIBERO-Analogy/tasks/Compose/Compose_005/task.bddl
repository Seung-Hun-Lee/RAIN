(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Put the moka pot on the stove, then close the microwave door)
  (:regions
      (flat_stove_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.21000000000000002 -0.21000000000000002 -0.19 -0.19)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (moka_pot_right_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.07500000000000001 0.225 -0.025 0.275)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (moka_pot_left_init_region
          (:target kitchen_table)
          (:ranges (
              (0.025 0.025 0.07500000000000001 0.07500000000000001)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cook_region
          (:target flat_stove_1)
      )
      (vcn21_microwave_sampling_only_region
          (:target kitchen_table)
          (:ranges (
              (-0.010000 0.340000 0.010000 0.360000)
            )
          )
          (:yaw_rotation (
              (0.000000000000 0.000000000000)
            )
          )
      )
      (top_side
          (:target microwave_1)
      )
      (heating_region
          (:target microwave_1)
      )
  )

  (:fixtures
    kitchen_table - kitchen_table
    flat_stove_1 - flat_stove
    microwave_1 - microwave
  )

  (:objects
    moka_pot_2 - moka_pot
  )

  (:obj_of_interest
    moka_pot_2
    flat_stove_1_cook_region
    microwave_1
  )

  (:init
    (On flat_stove_1 kitchen_table_flat_stove_init_region)
    (On moka_pot_2 kitchen_table_moka_pot_left_init_region)
    (Turnon flat_stove_1)
    (On microwave_1 kitchen_table_vcn21_microwave_sampling_only_region)
    (Open microwave_1)
  )

  (:goal
    (And (On moka_pot_2 flat_stove_1_cook_region) (Close microwave_1))
  )

)
