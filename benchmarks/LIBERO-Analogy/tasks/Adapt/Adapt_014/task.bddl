            )
          )
          (:yaw_rotation (
              (0.000000000000 0.000000000000)
            )
          )
      )
  )

  (:fixtures
    main_table - table
    short_fridge_1 - short_fridge
  )

  (:objects
    popcorn_1 - popcorn
    tomato_sauce_1 - tomato_sauce
    butter_1 - butter
    cream_cheese_1 - cream_cheese
  )

  (:obj_of_interest
    popcorn_1
    short_fridge_1_feedback_top_region
  )

  (:init
    (On short_fridge_1 main_table_short_fridge_1_init_region)
    (On popcorn_1 main_table_popcorn_1_init_region)
    (On tomato_sauce_1 main_table_tomato_sauce_1_init_region)
    (On butter_1 main_table_butter_1_init_region)
    (On cream_cheese_1 main_table_cream_cheese_1_init_region)
  )

  (:goal
