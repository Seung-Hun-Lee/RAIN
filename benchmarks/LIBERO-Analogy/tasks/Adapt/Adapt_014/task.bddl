              (-0.119 0.121 -0.061 0.179)
            )
          )
          (:yaw_rotation (
              (0.000000000000 0.000000000000)
            )
          )
      )
      (feedback_top_region
          (:target short_fridge_1)
      )
      (tomato_sauce_1_init_region
          (:target main_table)
          (:ranges (
              (-0.11900000 0.26100000 -0.06100000 0.31900000)
            )
          )
          (:yaw_rotation (
              (0.000000000000 0.000000000000)
            )
          )
      )
      (butter_1_init_region
          (:target main_table)
          (:ranges (
              (-0.25400000 0.12600000 -0.20600000 0.17400000)
            )
          )
          (:yaw_rotation (
              (0.000000000000 0.000000000000)
            )
          )
      )
      (cream_cheese_1_init_region
