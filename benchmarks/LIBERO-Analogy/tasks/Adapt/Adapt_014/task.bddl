          (:target main_table)
          (:ranges (
              (0.02990000 -0.24010000 0.03010000 -0.23990000)
            )
          )
          (:yaw_rotation (
              (3.141592653590 3.141592653590)
            )
          )
      )
      (popcorn_1_init_region
          (:target main_table)
